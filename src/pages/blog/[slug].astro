---
import Post from '../../layouts/Post.astro';
import { posts } from '../../data/blog.js';

export function getStaticPaths() {
  return posts.map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}
const { post } = Astro.props;

// Titles for related links, data posts plus the three hand-written posts.
const titleMap = Object.fromEntries(posts.map((p) => [p.slug, p.title]));
const legacy = {
  'how-we-built-trayaam': 'How we built trayaam.com to score 100/100',
  '7-day-website-rebuild-what-we-learned': 'What 32 website rebuilds taught us about speed',
  'core-web-vitals-smes': 'Core Web Vitals for Ambitious SMEs',
};
const related = (post.related || [])
  .map((s) => ({ slug: s, title: titleMap[s] || legacy[s] }))
  .filter((r) => r.title);
---
<Post title={post.title} description={post.description} path={`/blog/${post.slug}`} date={post.date} readtime={post.readtime} category={post.category}>
  <Fragment set:html={post.body} />
  {related.length > 0 && (
    <nav class="related" aria-label="Related reading">
      <div class="related__label">Related reading</div>
      <ul>{related.map((r) => (<li><a href={`/blog/${r.slug}`}>{r.title}</a></li>))}</ul>
    </nav>
  )}
</Post>
<style is:global>
  .article .related { margin-top: 3.5rem; padding-top: 1.8rem; border-top: 1px solid var(--border); }
  .article .related__label { font-family: var(--mono); font-size: 0.66rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--fg-lo); margin-bottom: 1rem; }
  .article .related ul { margin: 0; }
  .article .related li { list-style: none; margin-bottom: 0.6rem; }
  .article .related a { font-family: var(--serif); font-size: 1.1rem; text-decoration: none; }
  .article .related a:hover { color: var(--accent); }
</style>
