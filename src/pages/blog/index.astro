---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
const posts = [
  { href: '/blog/how-we-built-trayaam', cat: 'Behind the build', t: 'How we built trayaam.com to score 100/100', d: 'The stack, the decisions and the trade-offs behind a site that loads instantly.', date: 'Jun 2026', read: '6 min' },
  { href: '/blog/7-day-website-rebuild-what-we-learned', cat: 'Process', t: 'What 32 website rebuilds taught us about speed', d: 'Why a 7-day timeline produces better sites than a 7-week one — and how we do it.', date: 'May 2026', read: '5 min' },
  { href: '/blog/core-web-vitals-luxembourg-smes', cat: 'SEO', t: 'Core Web Vitals for Luxembourg SMEs', d: 'What the metrics actually mean for your rankings, and how to pass them.', date: 'Apr 2026', read: '7 min' },
];
---
<Layout title="Journal — Web Design & SEO Insights · Trayaam" description="The Trayaam Journal — practical notes on web design, performance, SEO and running a modern web agency, written for Luxembourg SMEs." active="blog" path="/blog">
<style>
  .posts { display: grid; gap: 1.2rem; margin-top: 3rem; }
  .post { display: grid; grid-template-columns: 0.25fr 1fr auto; gap: 2rem; align-items: center; }
  .post__cat { font-family: var(--mono); font-size: 0.66rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); }
  .post__read { font-family: var(--mono); font-size: 0.7rem; color: var(--fg-lo); white-space: nowrap; }
  @media (max-width: 767px) { .post { grid-template-columns: 1fr; gap: 0.7rem; } }
</style>
<PageHero eyebrow="Journal">
  <h1 slot="title" class="t-h1 reveal">Notes from the <em class="italic">studio.</em></h1>
  <p class="t-body-lg reveal reveal-d1">Practical thinking on design, performance and SEO — written for the people who actually run the business.</p>
</PageHero>
<section class="section section--major section--line">
  <div class="container">
    <div class="posts">
      {posts.map((p) => (
        <a href={p.href} class="card post reveal">
          <span class="post__cat">{p.cat}</span>
          <div><h2 class="t-h4" style="margin-bottom:0.4rem;">{p.t}</h2><p class="t-body" style="font-size:0.92rem;">{p.d}</p></div>
          <span class="post__read">{p.date} · {p.read}</span>
        </a>
      ))}
    </div>
  </div>
</section>
</Layout>
