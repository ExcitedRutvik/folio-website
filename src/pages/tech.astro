---
import Layout from '../layouts/Layout.astro';
import SectionHead from '../components/SectionHead.astro';

const groups = [
  { n: '01', label: 'Design', items: ['Figma'], copy: 'Every build starts in Figma. You approve the design before we write a line of code.' },
  { n: '02', label: 'Frontend', items: ['Astro', 'Next.js'], copy: 'The lightest tool that does the job — Astro for editorial, Next.js for product.' },
  { n: '03', label: 'CMS', items: ['Sanity', 'Payload'], copy: 'Structured, editable content so you update the site yourself — no developer needed.' },
  { n: '04', label: 'Hosting', items: ['Vercel', 'Netlify'], copy: 'Deployed to a global edge network. Fast everywhere, secure by default.' },
  { n: '05', label: 'CDN & Email', items: ['Cloudflare', 'Resend'], copy: 'Edge caching and reliable transactional email, wired in from day one.' },
  { n: '06', label: 'Analytics & SEO', items: ['GA4', 'Search Console', 'Ahrefs'], copy: 'Measurement and search visibility built in — so growth is observable, not guessed.' },
];
---
<Layout title="Perception Technology — The Trayaam Stack" description="Perception Technology: the living tech stack behind every Trayaam 7-day build — Astro, Next.js, Sanity, Vercel, Cloudflare, GA4. Fast by construction, owned by you." active="tech" path="/tech">
<style>
  .tech-hero { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(2rem,5vw,4rem); align-items: center;
    padding-block: calc(72px + clamp(56px, 9vw, 120px)) clamp(48px, 7vw, 96px); }
  .tech-hero__copy { max-width: 52ch; }
  .netmap { position: relative; aspect-ratio: 1 / 1; width: 100%; border: 1px solid var(--border); border-radius: var(--r-lg); background: var(--bg-1); overflow: hidden; }
  .netmap canvas { width: 100%; height: 100%; display: block; }
  .netmap__hint { position: absolute; bottom: 0.9rem; left: 1rem; font-family: var(--mono); font-size: 0.62rem; letter-spacing: 0.08em; color: var(--fg-faint); text-transform: uppercase; pointer-events: none; }
  @media (max-width: 900px) { .tech-hero { grid-template-columns: 1fr; } .netmap { max-width: 460px; margin-inline: auto; } }

  .stack { display: grid; gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: var(--r-lg); overflow: hidden; margin-top: 3rem; }
  .layer { background: var(--bg-1); padding: clamp(1.6rem,2.6vw,2.4rem); display: grid; grid-template-columns: 0.3fr 0.7fr 1fr; gap: 2rem; align-items: center; transition: background 0.25s var(--ease); }
  .layer:hover { background: var(--bg-2); }
  .layer__n { font-family: var(--mono); font-size: 0.74rem; color: var(--accent); }
  .layer__label { font-family: var(--serif); font-size: clamp(1.3rem,2.2vw,1.9rem); font-weight: 400; }
  .layer__right { display: flex; flex-direction: column; gap: 0.9rem; }
  .pills { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .pill { font-family: var(--mono); font-size: 0.72rem; color: var(--accent); background: var(--accent-dim); border: 1px solid var(--accent-mid); border-radius: 100px; padding: 0.3rem 0.9rem; }
  @media (max-width: 767px) { .layer { grid-template-columns: 1fr; gap: 0.8rem; } }
</style>

<!-- TWO-COLUMN HERO: copy left, living network map right -->
<section class="section--line">
  <div class="container tech-hero">
    <div class="tech-hero__copy">
      <span class="eyebrow reveal">Perception Technology</span>
      <h1 class="t-h1 reveal" style="margin:1.5rem 0;">The stack that<br>your visitors <em class="italic">feel.</em></h1>
      <p class="t-body-lg reveal reveal-d1">Perception Technology is how we think about the stack: every tool earns its place by changing what a visitor perceives — speed, clarity, trust. No WordPress, no page builders, no bloat. Just battle-tested modern tools that load fast, scale well, and hand you full control from day one.</p>
      <div class="reveal reveal-d2" style="margin-top:2rem;"><a href="/contact" class="btn btn--accent">Get your free audit <span class="arr">→</span></a></div>
    </div>
    <div class="netmap reveal reveal-d1" aria-hidden="true">
      <canvas id="netmap"></canvas>
      <span class="netmap__hint">Living tech stack · hover a node</span>
    </div>
  </div>
</section>

<section class="section section--major section--line">
  <div class="container">
    <SectionHead eyebrow="The layers"><h2 slot="title" class="t-h2">Six layers, <em class="italic">one fast site.</em></h2></SectionHead>
    <div class="stack">
      {groups.map((g) => (
        <div class="layer reveal">
          <div class="layer__n">{g.n}</div>
          <div class="layer__label">{g.label}</div>
          <div class="layer__right">
            <div class="pills">{g.items.map((i) => (<span class="pill">{i}</span>))}</div>
            <p class="t-body" style="font-size:0.9rem;">{g.copy}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
<section class="section section--major section--line section--surface">
  <div class="container container--narrow" style="text-align:center;">
    <SectionHead eyebrow="Built right" align="center"><h2 slot="title" class="t-h2">Fast by <em class="italic">construction.</em></h2><p class="t-body">Performance isn't a plugin we add at the end — it's the consequence of the stack. Most builds ship at 95–100 on Lighthouse.</p></SectionHead>
    <div style="margin-top:2rem;"><a href="/contact" class="btn btn--accent">Get your free audit <span class="arr">→</span></a></div>
  </div>
</section>

<script is:inline>
  /* Living Tech Stack — perceptual network map (lightweight canvas + spring physics) */
  (function () {
    var canvas = document.getElementById('netmap');
    if (!canvas) return;
    var ctx = canvas.getContext('2d');
    var wrap = canvas.parentElement;
    var DPR = Math.min(window.devicePixelRatio || 1, 2);
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var labels = ['Figma','Astro','Next.js','Sanity','Vercel','Cloudflare','Resend','GA4','Ahrefs','Edge'];
    // edges by index — a loosely connected perceptual graph
    var edges = [[0,1],[0,2],[1,4],[2,4],[1,3],[2,3],[4,5],[5,6],[4,9],[5,9],[7,8],[7,9],[3,7],[1,7],[8,2],[6,9]];
    var nodes = [];

    function css(v) { return getComputedStyle(document.documentElement).getPropertyValue(v).trim(); }
    var W, H, accent, fg, line;

    function resize() {
      W = wrap.clientWidth; H = wrap.clientHeight;
      canvas.width = W * DPR; canvas.height = H * DPR;
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      accent = css('--accent') || '#C9A86A';
      fg = css('--fg') || '#F4F1E8';
      line = 'rgba(' + (css('--accent-rgb') || '201,168,106') + ',0.22)';
    }

    function init() {
      resize();
      nodes = labels.map(function (l, i) {
        var a = (i / labels.length) * Math.PI * 2;
        var r = Math.min(W, H) * (0.18 + 0.16 * (i % 3));
        return { l: l, x: W/2 + Math.cos(a)*r, y: H/2 + Math.sin(a)*r,
          hx: W/2 + Math.cos(a)*r, hy: H/2 + Math.sin(a)*r, vx: 0, vy: 0, r: 5 + (i % 3) };
      });
    }

    var mouse = { x: -999, y: -999, on: false };
    canvas.addEventListener('pointermove', function (e) {
      var b = canvas.getBoundingClientRect();
      mouse.x = e.clientX - b.left; mouse.y = e.clientY - b.top; mouse.on = true;
    });
    canvas.addEventListener('pointerleave', function () { mouse.on = false; mouse.x = -999; mouse.y = -999; });

    var t = 0;
    function frame() {
      t += 0.008;
      ctx.clearRect(0, 0, W, H);
      // springs: drift around home + react to cursor
      nodes.forEach(function (n, i) {
        var driftX = Math.cos(t + i) * 6, driftY = Math.sin(t * 1.2 + i) * 6;
        var tx = n.hx + driftX, ty = n.hy + driftY;
        if (mouse.on) {
          var dx = n.x - mouse.x, dy = n.y - mouse.y, d = Math.hypot(dx, dy);
          if (d < 120) { var f = (120 - d) / 120 * 0.6; tx += dx / (d||1) * f * 30; ty += dy / (d||1) * f * 30; }
        }
        n.vx += (tx - n.x) * 0.02; n.vy += (ty - n.y) * 0.02;
        n.vx *= 0.86; n.vy *= 0.86;
        n.x += n.vx; n.y += n.vy;
      });
      // edges
      edges.forEach(function (e) {
        var a = nodes[e[0]], b = nodes[e[1]]; if (!a || !b) return;
        var near = mouse.on && (Math.hypot(a.x-mouse.x,a.y-mouse.y) < 90 || Math.hypot(b.x-mouse.x,b.y-mouse.y) < 90);
        ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y);
        ctx.strokeStyle = near ? accent : line; ctx.lineWidth = near ? 1.4 : 0.8; ctx.stroke();
      });
      // nodes
      nodes.forEach(function (n) {
        var hot = mouse.on && Math.hypot(n.x-mouse.x, n.y-mouse.y) < 60;
        ctx.beginPath(); ctx.arc(n.x, n.y, n.r + (hot ? 2 : 0), 0, Math.PI*2);
        ctx.fillStyle = accent; ctx.globalAlpha = hot ? 1 : 0.85; ctx.fill(); ctx.globalAlpha = 1;
        if (hot) {
          ctx.font = '600 11px JetBrains Mono, monospace'; ctx.fillStyle = fg; ctx.textAlign = 'center';
          ctx.fillText(n.l, n.x, n.y - n.r - 8);
        }
      });
      if (!reduce) requestAnimationFrame(frame);
    }

    init();
    window.addEventListener('resize', function () { resize(); init(); });
    if (reduce) { frame(); } else { requestAnimationFrame(frame); }
  })();
</script>
</Layout>
