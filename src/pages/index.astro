---
import Layout from '../layouts/Layout.astro';
import SectionHead from '../components/SectionHead.astro';

const faqs = [
  ['How is a 7-day website rebuild possible?', 'We audit first so there is no guessing phase, run design and development concurrently on a proven stack, and use two structured review rounds instead of open-ended feedback.'],
  ['What if I don\'t like the first draft?', 'Every package includes structured revisions and we share a Figma design before writing code, so changes are fast and cheap. We have never needed a third round.'],
  ['Do you work with clients outside London and Ahmedabad?', 'Yes. With studios in London and Ahmedabad we work with businesses right across the UK and India. The audit and the call happen over video, and everything else runs async, so location is never a blocker.'],
  ['Will I actually rank on Google?', 'No one can honestly guarantee rankings, but we guarantee the best possible starting position: the right structure, schema, sitemap, fast load and a real SEO foundation. Most clients see movement in 6 to 8 weeks.'],
  ['Do you charge upfront?', '50% on kick-off and 50% on launch, one fixed price agreed in writing before we start. The free audit is genuinely free, with no card required.'],
];

const jsonld = {
  "@context": "https://schema.org",
  "@graph": [
  {
  "@type": "LocalBusiness",
  "@id": "https://trayaam.com/#business",
  "name": "Trayaam",
  "description": "Full service digital growth partner with studios in London and Ahmedabad, helping ambitious businesses get found and win customers through design, build, SEO, marketing and automation. Fixed pricing, free audit, no surprise invoices.",
  "url": "https://trayaam.com",
  "email": "akash@trayaam.com",
  "telephone": "+919978984333",
  "priceRange": "££",
  "slogan": "Creativity · Technology · Empowerment",
  "address": [
    { "@type": "PostalAddress", "addressLocality": "London", "addressCountry": "GB" },
    { "@type": "PostalAddress", "addressLocality": "Ahmedabad", "addressRegion": "Gujarat", "addressCountry": "IN" }
  ],
  "areaServed": ["London","Ahmedabad","United Kingdom","India"].map((c) => ({ "@type": "City", name: c })),
  "hasOfferCatalog": {
    "@type": "OfferCatalog", "name": "Digital Growth Services",
    "itemListElement": [
      {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Quick Refresh"}, "price": "990", "priceCurrency": "GBP"},
      {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Full Rebuild"}, "price": "2500", "priceCurrency": "GBP"},
      {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Growth Partner"}, "price": "4500", "priceCurrency": "GBP"}
    ]
  }
  },
  {
    "@type": "FAQPage",
    "@id": "https://trayaam.com/#faq",
    "mainEntity": faqs.map(([q, a]) => ({ "@type": "Question", "name": q, "acceptedAnswer": { "@type": "Answer", "text": a } }))
  }
  ]
};

const pillars = [
  { k: 'Pillar 01', t: 'Creativity', d: 'Editorial, distinctive design that makes your brand impossible to confuse with anyone else. Ideas first.' },
  { k: 'Pillar 02', t: 'Technology', d: 'A fast, secure, modern stack: Astro, Next.js, edge hosting, and AI woven through the build and into custom automations. Execution measured in milliseconds.' },
  { k: 'Pillar 03', t: 'Empowerment', d: 'We hand you the keys: an editable site, clear reporting, and the confidence to grow on your terms.' },
];
const work = [
  { href: '/work/deepak-products', ind: 'Manufacturing · India', t: 'Deepak Products', d: 'A 35-year sheet-metal manufacturer with no real web presence → a B2B credibility engine with a 650-product catalogue.', stats: [['650+','Products'],['10+','Countries'],['B2B','Lead engine']] },
  { href: '/work/architect-studio', ind: 'Architecture · London', t: 'Architect studio', d: 'Invisible on Google to page one for "architects London" in six weeks.', stats: [['+68%','Enquiries'],['6d','Delivered'],['P.1','Ranked']] },
  { href: '/work/restaurant-643', ind: 'Hospitality · Ahmedabad', t: 'Restaurant 643', d: 'No mobile, broken form → online reservations and local SEO.', stats: [['+52%','Bookings'],['5d','Delivered'],['100%','Mobile']] },
];
---
<Layout title="Digital Transformation & Growth Partner · Trayaam" description="Trayaam is a full service digital growth partner in London and Ahmedabad. We help ambitious businesses get found online and win more customers through design, build, SEO and marketing." active="home" path="/" jsonld={jsonld}>

<style>
  /* Hero */
  .hero { position: relative; min-height: 92vh; display: flex; align-items: center; padding-top: 72px; overflow: hidden; }
  .hero__bg { position: absolute; inset: 0; background:
      radial-gradient(ellipse 60% 90% at 82% 48%, rgba(201,168,106,0.10) 0%, transparent 60%),
      radial-gradient(ellipse 90% 70% at 10% 100%, rgba(201,168,106,0.04) 0%, transparent 55%); pointer-events: none; }
  .hero__grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 4vw; align-items: center; width: 100%; }
  .hero__title { margin: 1.6rem 0 2rem; font-size: clamp(2rem, 4.4vw, 4.1rem); line-height: 1.0; }
  .hero__line { display: block; overflow: hidden; }
  .hero__line > span { display: block; transform: translateY(105%); animation: heroRise 1s var(--ease) forwards; }
  .hero__line:nth-child(2) > span { animation-delay: 0.09s; }
  .hero__line:nth-child(3) > span { animation-delay: 0.18s; }
  @keyframes heroRise { to { transform: none; } }
  .hero__sub { max-width: 46ch; margin-bottom: 2.4rem; }
  .hero__actions { display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; }
  .hero__trust { display: flex; gap: 2.2rem; margin-top: 3rem; padding-top: 1.6rem; border-top: 1px solid var(--border); flex-wrap: wrap; }
  .hero__trust b { font-family: var(--serif); font-weight: 400; color: var(--accent); margin-right: 0.4em; }
  .hero__trust span { font-size: 0.86rem; color: var(--fg-med); }

  /* city rotator */
  .city { display: inline-grid; vertical-align: bottom; }
  .city > span { grid-area: 1 / 1; }
  .city__spacer { visibility: hidden; }
  .city__active { color: var(--accent); animation: cityIn 0.5s var(--ease); }
  @keyframes cityIn { from { opacity: 0; transform: translateY(0.18em); } to { opacity: 1; transform: none; } }

  /* terminal / glass display */
  .hero__art { perspective: 1400px; }
  .glass { position: relative; border-radius: 14px; background: var(--term-bg); border: 1px solid var(--border-med);
    box-shadow: var(--term-shadow); overflow: hidden; transform: rotateY(-7deg) rotateX(3deg); transition: transform 0.5s var(--ease); min-height: 380px; }
  .hero__art:hover .glass { transform: rotateY(-3deg) rotateX(1.5deg); }
  .glass::after { content: ''; position: absolute; inset: 0; background: linear-gradient(120deg, rgba(255,255,255,0.06), transparent 40%); pointer-events: none; }
  .term__bar { display: flex; align-items: center; gap: 0.5rem; padding: 0.8rem 1rem; background: var(--term-bar); border-bottom: 1px solid var(--border); }
  .term__dot { width: 11px; height: 11px; border-radius: 50%; background: rgba(255,255,255,0.18); }
  .term__dot:nth-child(1) { background: #ff5f57; } .term__dot:nth-child(2) { background: #febc2e; } .term__dot:nth-child(3) { background: #28c840; }
  .term__title { margin-left: 0.6rem; font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.02em; color: var(--fg-lo); }
  .term__body { padding: 1.5rem 1.5rem 1.8rem; font-family: var(--mono); font-size: 0.82rem; letter-spacing: -0.01em; line-height: 2; color: var(--term-fg); min-height: 380px; font-feature-settings: 'zero' 1, 'ss02' 1; }
  .term__body .ok { color: var(--accent-2); }
  .term__body .ok::before { content: ''; }
  .term__body .cmd { color: var(--term-fg); font-weight: 500; }
  .term__body .cmd::first-letter { color: var(--accent); }
  .term__cursor { display: inline-block; width: 8px; height: 1.05em; background: var(--accent); vertical-align: -2px; animation: blink 1s step-end infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  /* deployed analytics dashboard revealed after boot */
  .preview { position: absolute; inset: 0; background: linear-gradient(180deg, var(--bg-1), var(--bg-2)); display: flex; flex-direction: column; opacity: 0; pointer-events: none; transition: opacity 0.5s var(--ease); }
  .preview.show { opacity: 1; pointer-events: auto; }
  .preview__bar { display: flex; align-items: center; gap: 0.6rem; padding: 0.7rem 1rem; border-bottom: 1px solid var(--border); }
  .preview__url { flex: 1; font-family: var(--mono); font-size: 0.66rem; color: var(--fg-lo); background: var(--bg-3); border-radius: 100px; padding: 0.35rem 0.9rem; }
  .preview__live { display: inline-flex; align-items: center; gap: 0.4em; font-family: var(--mono); font-size: 0.58rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); }
  .preview__live::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: #28c840; box-shadow: 0 0 0 0 rgba(40,200,64,0.5); animation: livePulse 1.8s ease-out infinite; }
  @keyframes livePulse { to { box-shadow: 0 0 0 6px rgba(40,200,64,0); } }
  .dash { flex: 1; display: flex; flex-direction: column; gap: 1rem; padding: 1.3rem 1.4rem; }
  .dash__head { display: flex; align-items: baseline; justify-content: space-between; gap: 0.5rem; }
  .dash__title { font-family: var(--serif); font-size: 1.15rem; font-weight: 400; }
  .gauges { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.7rem; }
  .gauge { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; padding: 0.4rem 0; }
  .gauge svg { width: 100%; max-width: 74px; height: auto; }
  .gauge__track { stroke: var(--border-med); }
  .gauge__arc { stroke: var(--accent); stroke-linecap: round; stroke-dasharray: 163.4; stroke-dashoffset: 163.4; transform: rotate(-90deg); transform-origin: center; }
  .preview.show .gauge__arc { animation: gaugeFill 1s var(--ease-out) 0.15s forwards; }
  @keyframes gaugeFill { to { stroke-dashoffset: 0; } }
  .gauge__num { font-family: var(--serif); font-size: 1.05rem; fill: var(--accent); }
  .gauge__lbl { font-family: var(--mono); font-size: 0.54rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--fg-lo); text-align: center; }
  .kpis { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; margin-top: auto; }
  .kpi { background: var(--bg-1); padding: 0.7rem 0.5rem; text-align: center; }
  .kpi__v { font-family: var(--serif); font-size: 1.15rem; color: var(--fg); line-height: 1; }
  .kpi__v .accent { color: var(--accent); }
  .kpi__l { font-size: 0.52rem; color: var(--fg-lo); letter-spacing: 0.04em; text-transform: uppercase; margin-top: 0.3rem; }
  @media (max-width: 900px) { .hero__grid { grid-template-columns: 1fr; gap: 2rem; } .hero__art { order: 2; } .glass { transform: none; min-height: 360px; } }

  /* "What Trayaam means", two-column: animated emblem left, copy right.
     Emblem sits cleanly on the dark bg (no frame), with a two-phase
     "lotus bloom → pillar rise" entrance triggered on scroll-into-view. */
  .tm { display: grid; grid-template-columns: 0.82fr 1fr; gap: clamp(2rem, 6vw, 5.5rem); align-items: center; }
  .tm-logo { position: relative; isolation: isolate; display: grid; place-items: center; padding: clamp(1rem, 3vw, 2.5rem); }
  .crest__halo { position: absolute; width: min(72%, 320px); aspect-ratio: 1; border-radius: 50%; pointer-events: none;
    background: radial-gradient(circle, rgba(var(--accent-rgb),0.20), transparent 62%); opacity: 0;
    animation: haloIn 1.2s var(--ease-out) 0.2s forwards, haloBreathe 6s ease-in-out 1.4s infinite; }
  /* whole emblem, uncropped, simple fade-and-rise in, then a gentle perpetual float */
  .logomark { position: relative; width: clamp(120px, 13vw, 170px); aspect-ratio: 600 / 716; z-index: 1; opacity: 0; }
  .logomark img { width: 100%; height: 100%; display: block; object-fit: contain;
    filter: drop-shadow(0 14px 32px rgba(var(--accent-rgb),0.22)); }
  .tm-logo.in .logomark { animation: emblemIn 0.9s var(--ease-out) 0.1s forwards, lmFloat 6.5s ease-in-out 1.1s infinite; }
  @keyframes haloIn { to { opacity: 1; } }
  @keyframes haloBreathe { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.12); } }
  @keyframes emblemIn { 0% { opacity: 0; transform: translateY(16px) scale(0.96); } 100% { opacity: 1; transform: none; } }
  @keyframes lmFloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-7px); } }
  @media (max-width: 900px) {
    .tm { grid-template-columns: 1fr; gap: 2.6rem; }
    .tm-copy { text-align: center; }
    .tm-copy :global(.section-head) { margin-inline: auto; }
    .tm-copy :global(.section-head .eyebrow) { justify-content: center; }
    .tm-copy :global(.section-head p) { margin-inline: auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    .crest__halo, .logomark { animation: none !important; opacity: 1; transform: none; }
  }

  /* Pillars bento */
  .pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: var(--r-lg); overflow: hidden; }
  .pillar { background: var(--bg-1); padding: clamp(2rem,3vw,3rem); display: flex; flex-direction: column; gap: 0.9rem; transition: background 0.4s var(--ease); }
  .pillar:hover { background: var(--bg-2); }
  .pillar__k { font-family: var(--mono); font-size: 0.66rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent); }
  @media (max-width: 767px) { .pillars { grid-template-columns: 1fr; } }

  /* Services bento */
  .svc { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }
  .svc__card { display: flex; flex-direction: column; justify-content: space-between; gap: 2.5rem; min-height: 260px; }
  .svc__card--feat { grid-row: span 2; background: linear-gradient(160deg, rgba(201,168,106,0.08), var(--bg-1) 55%); border-color: var(--accent-mid); }
  .svc__top { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .svc__price { font-family: var(--mono); font-size: 0.8rem; color: var(--accent); white-space: nowrap; }
  .svc__link { color: var(--fg); font-size: 0.88rem; display: inline-flex; gap: 0.5em; }
  @media (max-width: 767px) { .svc { grid-template-columns: 1fr; } .svc__card--feat { grid-row: auto; } }

  /* Work */
  .work { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; }
  .work__ind { font-family: var(--mono); font-size: 0.64rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--fg-lo); }
  .work__stats { display: flex; gap: 1.4rem; margin-top: 1.6rem; padding-top: 1.4rem; border-top: 1px solid var(--border); }
  .work__sv { font-family: var(--serif); font-size: 1.5rem; color: var(--accent); line-height: 1; }
  .work__sl { font-size: 0.7rem; color: var(--fg-lo); margin-top: 0.3rem; }
  @media (max-width: 900px) { .work { grid-template-columns: 1fr; } }

  /* Process */
  .proc { display: grid; gap: 0; }
  .proc__row { display: grid; grid-template-columns: 0.5fr 0.3fr 1.2fr; gap: 2rem; padding: 2.4rem 0; border-top: 1px solid var(--border); align-items: start; }
  .proc__row:last-child { border-bottom: 1px solid var(--border); }
  .proc__day { font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.1em; color: var(--accent); padding-top: 0.5rem; }
  @media (max-width: 767px) { .proc__row { grid-template-columns: 1fr; gap: 0.6rem; } }

  /* Guarantees */
  .guar { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: var(--r-lg); overflow: hidden; }
  .guar__c { background: var(--bg-1); padding: clamp(1.6rem,2.4vw,2.4rem); display: flex; flex-direction: column; gap: 0.8rem; }
  .guar__ic { width: 38px; height: 38px; border-radius: 10px; border: 1px solid var(--accent-mid); background: var(--accent-dim); color: var(--accent); display: grid; place-items: center; font-family: var(--serif); }
  @media (max-width: 900px) { .guar { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 767px) { .guar { grid-template-columns: 1fr; } }

  /* Testimonials */
  .tw { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; }
  .tw__stars { color: var(--accent); letter-spacing: 2px; margin-bottom: 1.2rem; }
  .tw__meta { margin-top: 1.6rem; font-size: 0.84rem; color: var(--fg-lo); }
  .tw__meta b { color: var(--fg); display: block; font-weight: 500; }
  @media (max-width: 900px) { .tw { grid-template-columns: 1fr; } }

  /* FAQ */
  .faq__grid { display: grid; grid-template-columns: 0.7fr 1.3fr; gap: clamp(2rem,5vw,5rem); align-items: start; }
  .faq__side { position: sticky; top: 110px; }
  details.q { border-top: 1px solid var(--border); }
  details.q:last-child { border-bottom: 1px solid var(--border); }
  details.q summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; gap: 1.5rem; align-items: center; padding: 1.5rem 0; }
  details.q summary::-webkit-details-marker { display: none; }
  details.q .qt { font-family: var(--serif); font-size: 1.15rem; }
  details.q .qtog { width: 30px; height: 30px; border-radius: 50%; border: 1px solid var(--border-med); display: grid; place-items: center; transition: all 0.3s var(--ease); flex-shrink: 0; }
  details.q[open] .qtog { background: var(--accent); color: var(--ink); transform: rotate(45deg); }
  details.q .qa { padding-bottom: 1.5rem; color: var(--fg-med); max-width: 60ch; line-height: 1.7; }
  @media (max-width: 767px) { .faq__grid { grid-template-columns: 1fr; } .faq__side { position: static; } }

  /* CTA */
  .cta { text-align: center; position: relative; overflow: hidden; }
  .cta__glow { position: absolute; top: 50%; left: 50%; width: 760px; height: 760px; border-radius: 50%; transform: translate(-50%,-50%);
    background: radial-gradient(circle, rgba(201,168,106,0.08), transparent 64%); pointer-events: none; }
</style>

<!-- HERO -->
<section class="hero">
  <div class="hero__bg"></div>
  <div class="container hero__grid">
    <div class="hero__left">
      <span class="eyebrow">Creativity · Technology · Empowerment</span>
      <h1 class="t-h1 hero__title">
        Your partner in digital<br>transformation and <em class="italic">growth.</em>
      </h1>
      <p class="t-body-lg hero__sub">We are the partner ambitious businesses bring in to get found, win attention and turn visitors into customers. Strategy, design, build, SEO and marketing, all under one roof.</p>
      <div class="hero__actions">
        <a href="/contact" class="btn btn--accent">Get your free audit <span class="arr">→</span></a>
        <a href="/work" class="btn btn--ghost">See our work <span class="arr">→</span></a>
      </div>
      <div class="hero__trust">
        <span><b>32+</b>Audits delivered</span>
        <span><b>7d</b>Avg. delivery</span>
        <span><b>+40%</b>More enquiries</span>
      </div>
    </div>
    <div class="hero__art reveal reveal-d1">
      <div class="glass">
        <div class="term__bar"><span class="term__dot"></span><span class="term__dot"></span><span class="term__dot"></span><span class="term__title">trayaam · zsh</span></div>
        <div class="term__body" id="term"></div>
        <div class="preview" id="preview">
          <div class="preview__bar"><span class="term__dot"></span><span class="term__dot"></span><span class="term__dot"></span><span class="preview__url">https://trayaam.com</span><span class="preview__live">Live · edge</span></div>
          <div class="dash">
            <div class="dash__head">
              <div class="dash__title">Performance dashboard</div>
              <span class="t-mono" style="color:var(--fg-faint);">Lighthouse · prod</span>
            </div>
            <div class="gauges">
              {[['Performance'],['SEO'],['Best practices']].map(([lbl]) => (
                <div class="gauge">
                  <svg viewBox="0 0 64 64" aria-hidden="true">
                    <circle class="gauge__track" cx="32" cy="32" r="26" fill="none" stroke-width="5"/>
                    <circle class="gauge__arc" cx="32" cy="32" r="26" fill="none" stroke-width="5"/>
                    <text class="gauge__num" x="32" y="32" text-anchor="middle" dominant-baseline="central">100</text>
                  </svg>
                  <span class="gauge__lbl">{lbl}</span>
                </div>
              ))}
            </div>
            <div class="kpis">
              <div class="kpi"><div class="kpi__v">32<span class="accent">+</span></div><div class="kpi__l">Audits</div></div>
              <div class="kpi"><div class="kpi__v">7<span class="accent">d</span></div><div class="kpi__l">Delivery</div></div>
              <div class="kpi"><div class="kpi__v"><span class="accent">+</span>40<span class="accent">%</span></div><div class="kpi__l">Enquiries</div></div>
              <div class="kpi"><div class="kpi__v">&lt;1<span class="accent">s</span></div><div class="kpi__l">Load</div></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    /* Terminal boot → preview reveal */
    (function () {
      var term = document.getElementById('term'), preview = document.getElementById('preview');
      if (!term) return;
      var lines = [
        { t: '$ trayaam optimise --brand', c: 'cmd' },
        { t: '  ✓ Running structural design pass', c: 'ok' },
        { t: '  ✓ Optimising semantic SEO + schema', c: 'ok' },
        { t: '  ✓ Compiling fluid UI components', c: 'ok' },
        { t: '  ✓ Tuning Core Web Vitals · 100 / 100 / 100', c: 'ok' },
        { t: '  ✓ Deploying to global edge', c: 'ok' },
        { t: '→ Site Optimized · live at trayaam.com', c: 'cmd' }
      ];
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        term.innerHTML = lines.map(function (l) { return '<div class="' + l.c + '">' + l.t + '</div>'; }).join('');
        if (preview) preview.classList.add('show'); return;
      }
      var li = 0, ci = 0, cur = null;
      function type() {
        if (li >= lines.length) { setTimeout(function () { if (preview) preview.classList.add('show'); }, 240); return; }
        if (ci === 0) { cur = document.createElement('div'); cur.className = lines[li].c; term.appendChild(cur); }
        var s = lines[li].t; cur.textContent = s.slice(0, ci + 1); ci++;
        if (ci < s.length) setTimeout(type, 10); else { li++; ci = 0; setTimeout(type, 52); }
      }
      var io = new IntersectionObserver(function (e) { if (e[0].isIntersecting) { io.disconnect(); type(); } }, { threshold: 0.3 });
      io.observe(term);
    })();
  </script>
</section>

<!-- MARQUEE -->
<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    {Array.from({ length: 2 }).map(() => (
      <div class="marquee__group">
        <span class="marquee__item">Web redesign<span class="dot">·</span></span>
