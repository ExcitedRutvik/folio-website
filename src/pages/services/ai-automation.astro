---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';

const capabilities = [
  ['Content & SEO pipelines', 'AI-assisted drafting, optimisation and publishing, from research and briefs to first drafts and on-page SEO, always with a human in the loop, so your site stays fresh and ranks.'],
  ['Lead capture & routing', 'Enquiries qualified, enriched and routed to the right person automatically. Instant first responses, CRM records created, nothing left sitting in an inbox.'],
  ['Support & FAQ assistants', 'On-brand AI assistants trained on your own content to answer customers instantly, around the clock, and hand off to a human when it matters.'],
  ['Sales & back-office automation', 'Email and LinkedIn sequences, lead nurturing, quotes, onboarding, invoicing, data extraction and reporting, wired together across your tools so there are fewer manual steps, fewer errors and hours back every week.'],
];
const steps = [
  ['01', 'Map', 'We audit your week and find the repetitive, rules-based work that AI should be doing, scored by time saved and impact.'],
  ['02', 'Design', 'We design the automation around your real tools and data, with clear guardrails and a human-in-the-loop where judgement matters.'],
  ['03', 'Build', 'We build and wire it in across LLM APIs, your CRM, your site and your stack, and test it against real cases until it is reliable.'],
  ['04', 'Hand over', 'You own it. We document it, train your team, and stay available while the automation runs in the background.'],
];
const outcomes = [
  ['24/7', 'Always-on, running nights, weekends and in parallel'],
  ['Hours', 'Reclaimed every week from repetitive work'],
  ['Faster', 'Speed-to-lead measured in seconds, not days'],
  ['Owned', 'Yours in full, with no lock-in and no black box'],
];
const faqs = [
  ['Is AI automation only for big companies?', 'No. A focused automation is often cheaper than the hours it replaces, frequently less than a part-time hire. Small businesses see the fastest payback because the repetitive work is so visible.'],
  ['Will AI replace my team?', 'No. It removes the grind so your team does the work only humans should. We design every automation with a human in the loop where judgement, tone or relationships matter.'],
  ['Do you integrate with our existing tools?', 'Yes. We wire automations into your website, CRM, inbox and the tools you already use, rather than forcing you onto a new platform.'],
  ['What does it cost?', 'Most automations are a fixed-price build plus small running costs (the AI usage), then they work indefinitely. We scope each one honestly against the hours it saves.'],
];
const jsonld = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Service", "name": "AI, Sales & Business Process Automation", "provider": { "@type": "Organization", "name": "Trayaam" }, "areaServed": ["United Kingdom", "India"], "description": "Custom AI and business process automation for businesses: content and SEO pipelines, lead capture and routing, sales and email automation, support assistants and back-office workflows, built into your existing tools." },
    { "@type": "FAQPage", "mainEntity": faqs.map(([q, a]) => ({ "@type": "Question", "name": q, "acceptedAnswer": { "@type": "Answer", "text": a } })) }
  ]
};
---
<Layout title="AI, Sales & Business Process Automation · Trayaam" description="Trayaam builds custom AI and business process automation: content and SEO pipelines, lead capture and routing, sales and email automation, support assistants and back-office workflows, wired into your existing tools." active="services" path="/services/ai-automation" jsonld={jsonld}>
<style>
  .ai-hero { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(2rem,5vw,4rem); align-items: center;
    padding-block: calc(72px + clamp(56px, 9vw, 120px)) clamp(48px, 7vw, 96px); }
  .ai-hero__copy { max-width: 54ch; }
  .flow { position: relative; aspect-ratio: 1 / 1; width: 100%; max-width: 460px; margin-inline: auto; border: 1px solid var(--border); border-radius: var(--r-lg); background: var(--bg-1); overflow: hidden; }
  .flow canvas { width: 100%; height: 100%; display: block; }
  .flow__hint { position: absolute; bottom: 0.9rem; left: 1rem; font-family: var(--mono); font-size: 0.6rem; letter-spacing: 0.08em; color: var(--fg-faint); text-transform: uppercase; }
  .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: var(--r-lg); overflow: hidden; margin-top: 3rem; }
  .step { background: var(--bg-1); padding: clamp(1.6rem,2.4vw,2.2rem); display: flex; flex-direction: column; gap: 0.7rem; transition: background 0.25s var(--ease); }
  .step:hover { background: var(--bg-2); }
  .step__n { font-family: var(--mono); font-size: 0.72rem; color: var(--accent); letter-spacing: 0.1em; }
  .out { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.2rem; margin-top: 3rem; }
  .out__v { font-family: var(--serif); font-size: clamp(1.8rem,3vw,2.6rem); color: var(--accent); line-height: 1; }
  .out__l { color: var(--fg-med); margin-top: 0.6rem; font-size: 0.86rem; }
  .qa { border-top: 1px solid var(--border); padding: 1.6rem 0; }
  .qa:last-child { border-bottom: 1px solid var(--border); }
  .qa h3 { font-family: var(--serif); font-weight: 400; font-size: 1.2rem; margin-bottom: 0.7rem; }
  @media (max-width: 900px) { .ai-hero { grid-template-columns: 1fr; } .steps { grid-template-columns: 1fr 1fr; } .out { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .steps, .out { grid-template-columns: 1fr; } }
</style>

<!-- HERO -->
<section class="section--line">
  <div class="container ai-hero">
    <div class="ai-hero__copy">
      <span class="eyebrow reveal">Services · AI Automation</span>
      <h1 class="t-h1 reveal" style="margin:1.5rem 0;">Put your business<br><em class="italic">on autopilot.</em></h1>
      <p class="t-body-lg reveal reveal-d1">We design and build custom AI and business process automations that take repetitive work off your plate, so your website becomes an engine that runs while you sleep, and your team does the work only humans should.</p>
      <div class="reveal reveal-d2" style="margin-top:2rem;display:flex;gap:1rem;flex-wrap:wrap;">
        <a href="/contact" class="btn btn--accent">Scope an automation <span class="arr">→</span></a>
        <a href="/tech" class="btn btn--ghost">See our stack <span class="arr">→</span></a>
      </div>
    </div>
    <div class="flow reveal reveal-d1" aria-hidden="true">
      <canvas id="aiflow"></canvas>
      <span class="flow__hint">Inputs → AI → actions</span>
    </div>
  </div>
</section>

<!-- WHAT WE AUTOMATE -->
<section class="section section--major section--line">
  <div class="container">
    <SectionHead eyebrow="What we automate"><h2 slot="title" class="t-h2">Four ways AI<br><em class="italic">earns its keep.</em></h2><p class="t-body">Every automation is built around your real tools and data, never a one-size template. These are the highest-impact places to start.</p></SectionHead>
    <div class="grid grid-2" style="margin-top:3rem;">
      {capabilities.map(([t, d]) => (
        <div class="card reveal"><h3 class="t-h4" style="margin-bottom:0.7rem;">{t}</h3><p class="t-body" style="font-size:0.92rem;">{d}</p></div>
      ))}
    </div>
  </div>
</section>

<!-- HOW IT WORKS -->
<section class="section section--major section--line section--surface">
  <div class="container">
    <SectionHead eyebrow="How it works"><h2 slot="title" class="t-h2">From bottleneck<br>to <em class="italic">build.</em></h2></SectionHead>
    <div class="steps">
      {steps.map(([n, t, d]) => (
        <div class="step reveal"><span class="step__n">{n}</span><h3 class="t-h4">{t}</h3><p class="t-body" style="font-size:0.9rem;">{d}</p></div>
      ))}
    </div>
  </div>
</section>

<!-- OUTCOMES -->
<section class="section section--major section--line">
  <div class="container">
    <SectionHead eyebrow="Why it pays"><h2 slot="title" class="t-h2">Work that does<br><em class="italic">itself.</em></h2></SectionHead>
    <div class="out">
      {outcomes.map(([v, l]) => (<div class="card reveal"><div class="out__v">{v}</div><div class="out__l">{l}</div></div>))}
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="section section--major section--line section--surface">
  <div class="container container--narrow">
    <SectionHead eyebrow="Questions"><h2 slot="title" class="t-h2">Before you <em class="italic">automate.</em></h2></SectionHead>
    <div style="margin-top:2.5rem;">
      {faqs.map(([q, a]) => (<div class="qa reveal"><h3>{q}</h3><p class="t-body">{a}</p></div>))}
    </div>
  </div>
</section>

<!-- CTA -->
<section class="section section--major section--line">
  <div class="container container--narrow" style="text-align:center;">
    <SectionHead eyebrow="Let's talk" align="center"><h2 slot="title" class="t-h2">Tell us your<br><em class="italic">biggest time-sink.</em></h2><p class="t-body">Send us the one task that eats your week. We'll tell you honestly whether it's worth automating, and what it would take.</p></SectionHead>
    <div style="margin-top:2rem;"><a href="/contact" class="btn btn--accent">Scope an automation <span class="arr">→</span></a></div>
  </div>
</section>

<script is:inline>
  /* AI flow: inputs stream through a central AI node out to actions */
  (function () {
    var c = document.getElementById('aiflow'); if (!c) return;
    var ctx = c.getContext('2d'), wrap = c.parentElement;
    var DPR = Math.min(window.devicePixelRatio || 1, 2);
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var W, H, accent;
    function css(v) { return getComputedStyle(document.documentElement).getPropertyValue(v).trim(); }
    function resize() { W = wrap.clientWidth; H = wrap.clientHeight; c.width = W*DPR; c.height = H*DPR; ctx.setTransform(DPR,0,0,DPR,0,0); accent = css('--accent-rgb') || '201,168,106'; }
    resize(); window.addEventListener('resize', resize);
    var inputs = ['Form','Email','Chat','Data'], actions = ['Reply','Route','Draft','Update'];
    var particles = [];
    function spawn() { particles.push({ lane: Math.floor(Math.random()*inputs.length), t: 0, side: Math.random() < 0.5 ? 0 : 1 }); }
    var last = 0;
    function frame(now) {
      if (!last) last = now; var dt = Math.min((now - last)/1000, 0.05); last = now;
      ctx.clearRect(0,0,W,H);
      var cx = W/2, cy = H/2, R = Math.min(W,H)*0.13;
      var lx = W*0.16, rx = W*0.84;
      // lanes
      for (var i=0;i<4;i++){
        var iy = H*(0.22 + i*0.19);
        ctx.strokeStyle = 'rgba('+accent+',0.14)'; ctx.lineWidth=1;
        ctx.beginPath(); ctx.moveTo(lx, iy); ctx.quadraticCurveTo(cx-R*1.6, iy, cx, cy); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(cx, cy); ctx.quadraticCurveTo(cx+R*1.6, iy, rx, iy); ctx.stroke();
        // labels
        ctx.fillStyle='rgba('+accent+',0.7)'; ctx.font='600 9px JetBrains Mono, monospace';
        ctx.textAlign='left'; ctx.fillText(inputs[i], 8, iy-6);
        ctx.textAlign='right'; ctx.fillText(actions[i], W-8, iy-6);
      }
      // central AI node
      var pulse = reduce ? 0.5 : 0.5 + Math.sin(now/500)*0.5;
      var grad = ctx.createRadialGradient(cx,cy,0,cx,cy,R*2.4);
      grad.addColorStop(0,'rgba('+accent+','+(0.25+pulse*0.2)+')'); grad.addColorStop(1,'rgba('+accent+',0)');
      ctx.fillStyle=grad; ctx.beginPath(); ctx.arc(cx,cy,R*2.4,0,7); ctx.fill();
      ctx.fillStyle='rgba('+accent+',0.95)'; ctx.beginPath(); ctx.arc(cx,cy,R,0,7); ctx.fill();
      ctx.fillStyle='#0A0A0B'; ctx.font='700 '+Math.round(R*0.7)+'px JetBrains Mono, monospace'; ctx.textAlign='center'; ctx.textBaseline='middle'; ctx.fillText('AI', cx, cy+1); ctx.textBaseline='alphabetic';
      // particles
      if (!reduce) { if (Math.random()<0.08) spawn();
        for (var p=particles.length-1;p>=0;p--){ var pt=particles[p]; pt.t += dt*0.6;
          var iy2 = H*(0.22 + pt.lane*0.19); var x,y,tt;
          if (pt.t < 1) { tt=pt.t; x=qb(lx,cx-R*1.6,cx,tt); y=qb(iy2,iy2,cy,tt); }
          else if (pt.t < 2) { tt=pt.t-1; x=qb(cx,cx+R*1.6,rx,tt); y=qb(cy,iy2,iy2,tt); }
          else { particles.splice(p,1); continue; }
          ctx.fillStyle='rgba('+accent+',0.9)'; ctx.beginPath(); ctx.arc(x,y,2.4,0,7); ctx.fill();
        }
      }
      if (running) requestAnimationFrame(frame);
    }
    function qb(a,b,c2,t){ var u=1-t; return u*u*a + 2*u*t*b + t*t*c2; }
    // pause the rAF loop when the tab is hidden to save CPU/battery
    var running = true;
    document.addEventListener('visibilitychange', function () {
      if (document.hidden) { running = false; }
      else if (!running) { running = true; last = 0; requestAnimationFrame(frame); }
    });
    requestAnimationFrame(frame);
  })();
</script>
</Layout>
