---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
const values = [
  ['Creativity','Distinctive, editorial design. We make brands impossible to confuse with anyone else.'],
  ['Technology','A fast, secure, modern stack. Execution measured in milliseconds, owned by you.'],
  ['Empowerment','We hand over the keys and the clarity to grow, with no lock-in and no dependence.'],
];
const offices = [
  ['London','United Kingdom','Strategy, design direction and client partnerships across the UK.'],
  ['Ahmedabad','India','Engineering, performance and the production craft that ships your site in seven days.'],
];
// Team. Akash uses the hosted portrait; the others are clean placeholders, // drop a photo into /public and set `img` to reveal it.
const team = [
  { name: 'Akash Solanki', role: 'Founder', img: '/team-akash.jpg' },
  { name: 'Feny Solanki', role: 'Creative Director', img: '/team-feny.jpg' },
  { name: 'Rutvik Gupta', role: 'Chief Technical Officer', img: '/team-rutvik.jpg' },
];
---
<Layout title="About Trayaam · Your Digital Growth Partner" description="Trayaam is a full service digital growth partner with studios in London and Ahmedabad. Built on three pillars, creativity, technology and empowerment, we help ambitious businesses grow online, honestly and at a fixed price." active="about" path="/about">
<style>
  .offices { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; margin-top: 3rem; }
  .office__co { font-family: var(--mono); font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); margin-bottom: 0.8rem; }
  .office__city { font-family: var(--serif); font-size: 1.8rem; font-weight: 400; }
  .team { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; margin-top: 3rem; }
  .member__photo { display: block; aspect-ratio: 1 / 1; width: 100%; height: auto; border-radius: var(--r-lg); object-fit: cover; object-position: center center; background: var(--bg-3); border: 1px solid var(--border); }
  .member__ph { display: grid; place-items: center; aspect-ratio: 1 / 1; width: 100%; border-radius: var(--r-lg); background: linear-gradient(160deg, var(--bg-2), var(--bg-3)); border: 1px solid var(--border); color: var(--fg-faint); font-family: var(--serif); font-size: 2.4rem; }
  .member__name { font-family: var(--serif); font-size: 1.3rem; font-weight: 400; margin-top: 1rem; }
  .member__role { font-family: var(--mono); font-size: 0.66rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--fg-lo); margin-top: 0.4rem; }
  @media (max-width: 767px) { .team { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 767px) { .offices { grid-template-columns: 1fr; } }
</style>
<PageHero eyebrow="About · London &amp; Ahmedabad">
  <h1 slot="title" class="t-h1 reveal">A studio built on<br><em class="italic">three pillars.</em></h1>
  <p class="t-body-lg reveal reveal-d1"><span class="brand">Trayaam</span> means three. Creativity, technology and empowerment, the lotus at the heart of our mark, and the way we work. From studios in London and Ahmedabad, we help ambitious businesses get found, win customers and grow, quickly, honestly, and at a price agreed in writing before we start.</p>
</PageHero>

<!-- PILLARS -->
<section class="section section--major section--line">
  <div class="container">
    <SectionHead eyebrow="What we believe"><h2 slot="title" class="t-h2">Three forces,<br><em class="italic">one outcome.</em></h2></SectionHead>
    <div class="grid grid-3" style="margin-top:3rem;">
      {values.map(([t,d], i) => (<div class={`card reveal reveal-d${i+1}`}><div class="eyebrow" style="margin-bottom:1rem;">Pillar 0{i+1}</div><h3 class="t-h3" style="margin-bottom:0.8rem;">{t}</h3><p class="t-body">{d}</p></div>))}
    </div>
  </div>
</section>

<!-- HOW WE WORK + STATS -->
<section class="section section--major section--line section--surface">
  <div class="container">
    <div class="grid grid-2" style="gap:clamp(2rem,5vw,5rem);align-items:center;">
      <div class="reveal">
        <SectionHead eyebrow="How we work"><h2 slot="title" class="t-h3">Honest by <em class="italic">default.</em></h2></SectionHead>
        <p class="t-body" style="margin-top:1.5rem;">We audit before we sell. We quote one fixed price. We deliver, hand over everything, and tell you plainly if we're not the right fit. No retainers you can't leave, no surprise invoices, no jargon. Two studios across two time zones mean the work moves while you sleep, with design and direction from London and engineering and production from Ahmedabad.</p>
      </div>
      <div class="grid grid-2 reveal reveal-d1">
        <div class="card"><div class="stat__num"><span data-count="32">0</span><span class="accent">+</span></div><div class="stat__label">Websites audited</div></div>
        <div class="card"><div class="stat__num"><span data-count="7">0</span><span class="accent">d</span></div><div class="stat__label">Average delivery</div></div>
        <div class="card"><div class="stat__num">2</div><div class="stat__label">Studios, two time zones</div></div>
        <div class="card"><div class="stat__num">£0</div><div class="stat__label">Cost to start</div></div>
      </div>
    </div>
  </div>
</section>

<!-- DUAL HQ -->
<section class="section section--major section--line">
  <div class="container">
    <SectionHead eyebrow="Our studios"><h2 slot="title" class="t-h2">London &amp; <em class="italic">Ahmedabad.</em></h2><p class="t-body">One studio, two homes, chosen so creative direction and engineering craft each sit where they're strongest, and your project never stops moving.</p></SectionHead>
    <div class="offices">
      {offices.map(([city, country, note]) => (
        <div class="card reveal">
          <div class="office__co">{country}</div>
          <div class="office__city">{city}</div>
          <p class="t-body" style="font-size:0.92rem;margin-top:0.9rem;">{note}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- TEAM GRID -->
<section class="section section--major section--line section--surface">
  <div class="container">
    <SectionHead eyebrow="The team"><h2 slot="title" class="t-h2">The people<br><em class="italic">behind the work.</em></h2></SectionHead>
    <div class="team">
      {team.map((m) => (
        <div class="reveal">
          {m.img
            ? <img class="member__photo" src={m.img} alt={`${m.name}, ${m.role}, Trayaam`} width="320" height="320" loading="lazy" />
            : <div class="member__ph" aria-hidden="true">{m.name.charAt(0)}</div>}
          <div class="member__name">{m.name}</div>
          <div class="member__role">{m.role}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section section--major section--line">
  <div class="container container--narrow" style="text-align:center;">
    <SectionHead eyebrow="Let's talk" align="center"><h2 slot="title" class="t-h2">Start with a<br><em class="italic">free audit.</em></h2></SectionHead>
    <div style="margin-top:2rem;"><a href="/contact" class="btn btn--accent">Get yours <span class="arr">→</span></a></div>
  </div>
</section>
</Layout>
