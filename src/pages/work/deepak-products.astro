---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
const jsonld = { "@context":"https://schema.org","@type":"CreativeWork","name":"Deepak Products — Website Rebuild Case Study","about":"B2B industrial manufacturing website","creator":{"@type":"Organization","name":"Trayaam"} };
const stats = [['35+','Years in business'],['650+','Products catalogued'],['700+','Clients served'],['10+','Countries shipped']];
---
<Layout title="Deepak Products — B2B Industrial Website Case Study · Trayaam" description="How Trayaam rebuilt Deepak Products — a 35-year sheet-metal manufacturer — into a fast B2B website with a full product catalogue and enquiry flow." active="work" path="/work/deepak-products" jsonld={jsonld}>
<PageHero eyebrow="Case study · Manufacturing">
  <h1 slot="title" class="t-h1 reveal">Deepak <em class="italic">Products.</em></h1>
  <p class="t-body-lg reveal reveal-d1">A 35-year-old precision sheet-metal manufacturer with deep expertise but no real web presence. We rebuilt it into a B2B credibility engine — fast, structured, and built to generate enquiries from global industry.</p>
  <div class="reveal reveal-d2" style="margin-top:2rem;"><a href="https://lustrous-cuchufli-0fd203.netlify.app/" target="_blank" rel="noopener noreferrer" class="btn">Visit the live site <span class="arr">↗</span></a></div>
</PageHero>
<section class="section--compact section--line">
  <div class="container grid grid-4">
    {stats.map(([v,l]) => (<div class="reveal"><div class="stat__num"><span class="accent">{v}</span></div><div class="stat__label">{l}</div></div>))}
  </div>
</section>
<section class="section section--major section--line">
  <div class="container">
    <div class="grid grid-2" style="gap:clamp(2rem,5vw,5rem);align-items:start;">
      <div class="reveal">
        <SectionHead eyebrow="The challenge"><h2 slot="title" class="t-h3">Deep expertise,<br><em class="italic">invisible online.</em></h2></SectionHead>
        <p class="t-body" style="margin-top:1.5rem;">Decades of precision engineering — perforated and woven wire mesh, gratings, expanded metals — but a site that didn't reflect the quality, didn't work on mobile, and couldn't surface their 650+ products to buyers searching globally.</p>
      </div>
      <div class="reveal reveal-d1">
        <SectionHead eyebrow="What we did"><h2 slot="title" class="t-h3">A B2B engine,<br><em class="italic">built to convert.</em></h2></SectionHead>
        <p class="t-body" style="margin-top:1.5rem;">A clean, fast, mobile-first rebuild with a structured product catalogue, clear capability pages, and an enquiry flow that turns search traffic into qualified leads — all on a modern stack they fully own.</p>
      </div>
    </div>
  </div>
</section>
<section class="section section--major section--line section--surface">
  <div class="container container--narrow" style="text-align:center;">
    <SectionHead eyebrow="Want results like these?" align="center"><h2 slot="title" class="t-h2">Let's rebuild <em class="italic">yours.</em></h2></SectionHead>
    <div style="margin-top:2rem;"><a href="/contact" class="btn btn--accent">Get your free audit <span class="arr">→</span></a></div>
  </div>
</section>
</Layout>
