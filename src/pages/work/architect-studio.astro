---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
const jsonld = { "@context":"https://schema.org","@type":"CreativeWork","name":"Architect Studio — Website Rebuild Case Study","about":"Architecture practice portfolio website","creator":{"@type":"Organization","name":"Trayaam"} };
const stats = [['+68%','Enquiries'],['6d','Delivered'],['P.1','Google ranking'],['100','Lighthouse SEO']];
const sections = [
  ['The Challenge', 'Award-winning work, a forgettable site.', 'A respected London architecture studio with a portfolio of striking projects — and a five-year-old website that showed almost none of it. The old site was a wall of text, loaded slowly, and was effectively invisible in search. Prospective clients researching "architects London" never found them; those who did arrive left without seeing a single completed building.'],
  ['The Insight', 'Architecture is sold with the eye, not the paragraph.', 'People choose an architect emotionally, then justify it rationally. The studio needed imagery to lead — large, fast-loading project photography with the narrative underneath — and it needed to be found at the exact moment someone searches for a local practice. The fix was a portfolio-forward structure that doubled as an SEO foundation.'],
  ['The Execution', 'A portfolio that loads instantly and ranks.', 'We rebuilt the site around editable case-study templates: big imagery, optimised and lazy-loaded, with structured project metadata feeding rich search results. Clean local-SEO signals — schema, location pages, fast mobile performance — targeted "architects London" and surrounding boroughs. The studio can now publish a new project in minutes from the CMS.'],
];
const results = [['+68%','Increase in enquiries within 8 weeks'],['Page 1','For "architects London" in six weeks'],['6 days','Audit to live site'],['100/100','Lighthouse SEO and best practices']];
---
<Layout title="Architect Studio — Portfolio Website Case Study · Trayaam" description="How Trayaam rebuilt a London architecture studio into a portfolio-forward website that ranks page one for 'architects London' and lifted enquiries by 68%." active="work" path="/work/architect-studio" jsonld={jsonld}>
<style>
  .results { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.2rem; margin-top: 3rem; }
  .result__v { font-family: var(--serif); font-size: 2.2rem; color: var(--accent); line-height: 1; }
  .result__l { color: var(--fg-med); margin-top: 0.6rem; font-size: 0.95rem; }
  @media (max-width: 767px) { .results { grid-template-columns: 1fr; } }
</style>
<PageHero eyebrow="Case study · Architecture · London">
  <h1 slot="title" class="t-h1 reveal">Architect <em class="italic">studio.</em></h1>
  <p class="t-body-lg reveal reveal-d1">A respected London practice with a portfolio worth showing and a website that hid it. We rebuilt it into a fast, image-led site that ranks where new clients are looking.</p>
</PageHero>
<section class="section--compact section--line">
  <div class="container grid grid-4">
    {stats.map(([v,l]) => (<div class="reveal"><div class="stat__num"><span class="accent">{v}</span></div><div class="stat__label">{l}</div></div>))}
  </div>
</section>
{sections.map(([eyebrow, title, body], i) => (
  <section class={`section section--major section--line${i % 2 === 1 ? ' section--surface' : ''}`}>
    <div class="container">
      <div class="grid grid-2" style="gap:clamp(2rem,5vw,5rem);align-items:start;">
        <div class="reveal"><SectionHead eyebrow={eyebrow}><h2 slot="title" class="t-h3">{title}</h2></SectionHead></div>
        <p class="t-body reveal reveal-d1">{body}</p>
      </div>
    </div>
  </section>
))}
<section class="section section--major section--line">
  <div class="container">
    <SectionHead eyebrow="The Outcomes"><h2 slot="title" class="t-h2">Results that <em class="italic">compound.</em></h2></SectionHead>
    <div class="results">
      {results.map(([v,l]) => (<div class="card reveal"><div class="result__v">{v}</div><div class="result__l">{l}</div></div>))}
    </div>
  </div>
</section>
<section class="section section--major section--line section--surface">
  <div class="container container--narrow" style="text-align:center;">
    <SectionHead eyebrow="Want results like these?" align="center"><h2 slot="title" class="t-h2">Let's rebuild <em class="italic">yours.</em></h2></SectionHead>
    <div style="margin-top:2rem;"><a href="/contact" class="btn btn--accent">Get your free audit <span class="arr">→</span></a></div>
  </div>
</section>
</Layout>
