---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';

const cases = [
  { slug: '/work/deepak-products', ind: 'Manufacturing · India', t: 'Deepak Products', d: 'A 35-year sheet-metal manufacturer with no real web presence, rebuilt into a B2B credibility engine with product catalogue and enquiry flow.', stats: [['650+','Products'],['10+','Countries'],['B2B','Lead engine']], live: true },
  { slug: '/work/architect-studio', ind: 'Architecture · London', t: 'Architect studio', d: '5-year-old static site rebuilt into a portfolio-forward website. From invisible to page one for "architects London" in six weeks.', stats: [['+68%','Enquiries'],['6d','Delivered'],['P.1','Ranked']] },
  { slug: '/work/restaurant-643', ind: 'Hospitality · Ahmedabad', t: 'Restaurant 643', d: 'A 7-year-old site with no mobile support and a broken form. Rebuilt with online reservations, live menu and local SEO.', stats: [['+52%','Bookings'],['5d','Delivered'],['100%','Mobile']] },
  { slug: '/work/fiduciary-firm', ind: 'Accounting · London', t: 'Fiduciary firm', d: 'No SSL and an 18/100 score. Rebuilt with secure hosting, clear service pages and SME-targeted local SEO.', stats: [['+44%','Clients'],['7d','Delivered'],['SSL','Secured']] },
];
---
<Layout title="Case Studies & Results · Trayaam" description="Selected work from Trayaam, websites rebuilt for ambitious businesses across London, Ahmedabad and beyond. Real before/after metrics, PageSpeed gains and ranking improvements." active="work" path="/work">
<style>
  .cases { display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem; margin-top: 3.5rem; }
  .case { display: flex; flex-direction: column; }
  .case__ind { font-family: var(--mono); font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--fg-lo); }
  .case__live { color: var(--accent); }
  .case__stats { display: flex; gap: 2rem; margin-top: auto; padding-top: 1.6rem; border-top: 1px solid var(--border); }
  .case__sv { font-family: var(--serif); font-size: 1.7rem; color: var(--accent); line-height: 1; }
  .case__sl { font-size: 0.7rem; color: var(--fg-lo); margin-top: 0.35rem; }
  @media (max-width: 767px) { .cases { grid-template-columns: 1fr; } }
</style>
<PageHero eyebrow="Selected work">
  <h1 slot="title" class="t-h1 reveal">Proof, not <em class="italic">promises.</em></h1>
  <p class="t-body-lg reveal reveal-d1">Real rebuilds for real businesses, with the before/after numbers to back them up. Here's a snapshot of recent work.</p>
</PageHero>
<section class="section section--major section--line">
  <div class="container">
    <div class="cases">
      {cases.map((c) => (
        <a href={c.slug} class="card case reveal">
          <div class="case__ind">{c.ind}{c.live ? <span class="case__live"> · Live ↗</span> : null}</div>
          <h2 class="t-h3" style="margin:1rem 0 0.7rem;">{c.t}</h2>
          <p class="t-body" style="margin-bottom:1.6rem;">{c.d}</p>
          <div class="case__stats">{c.stats.map(([v,l]) => (<div><div class="case__sv">{v}</div><div class="case__sl">{l}</div></div>))}</div>
        </a>
      ))}
    </div>
  </div>
</section>
<section class="section section--major section--line section--surface">
  <div class="container container--narrow" style="text-align:center;">
    <SectionHead eyebrow="Your project next?" align="center"><h2 slot="title" class="t-h2">Let's build something<br><em class="italic">worth showing.</em></h2></SectionHead>
    <div style="margin-top:2rem;"><a href="/contact" class="btn btn--accent">Get your free audit <span class="arr">→</span></a></div>
  </div>
</section>
</Layout>
