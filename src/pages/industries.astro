---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import { industries } from '../data/industries.js';
---
<Layout title="Industries We Build For — Trayaam" description="Trayaam builds websites for architecture, hospitality, professional services, manufacturing, retail, SaaS, real estate, healthcare, legal and construction — tailored to how each industry wins clients." active="industries" path="/industries">
<style>
  .ind-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.2rem; }
  .ind-card { display: flex; flex-direction: column; }
  .ind-card__kw { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 1.2rem; }
  .ind-card__kw span { font-family: var(--mono); font-size: 0.62rem; letter-spacing: 0.04em; color: var(--accent); background: var(--accent-dim); border: 1px solid var(--accent-mid); border-radius: 100px; padding: 0.22rem 0.65rem; }
  .ind-card__link { margin-top: 1.4rem; font-size: 0.86rem; color: var(--fg); display: inline-flex; gap: 0.5em; }
  @media (max-width: 767px) { .ind-grid { grid-template-columns: 1fr; } }
</style>
<PageHero eyebrow="Industries">
  <h1 slot="title" class="t-h1 reveal">Built for how<br>your industry <em class="italic">wins.</em></h1>
  <p class="t-body-lg reveal reveal-d1">We've rebuilt sites across ten very different sectors — and each one converts differently. Choose your industry to see exactly how we tailor the work.</p>
</PageHero>
<section class="section section--major section--line">
  <div class="container">
    <div class="ind-grid">
      {industries.map((ind) => (
        <a href={`/industries/${ind.slug}`} class="card ind-card reveal">
          <h2 class="t-h3" style="margin-bottom:0.8rem;">{ind.title}</h2>
          <p class="t-body" style="font-size:0.92rem;">{ind.card}</p>
          <div class="ind-card__kw">{ind.keywords.slice(0, 3).map((k) => (<span>{k}</span>))}</div>
          <span class="ind-card__link">Explore {ind.title.split(' ')[0].toLowerCase()} websites <span class="arr">→</span></span>
        </a>
      ))}
    </div>
  </div>
</section>
<section class="section section--major section--line section--surface">
  <div class="container container--narrow" style="text-align:center;">
    <SectionHead eyebrow="Don't see yours?" align="center"><h2 slot="title" class="t-h2">We adapt to <em class="italic">your</em> market.</h2></SectionHead>
    <div style="margin-top:2rem;"><a href="/contact" class="btn btn--accent">Get your free audit <span class="arr">→</span></a></div>
  </div>
</section>
</Layout>
