---
// Trayaam monogram: a slab-serif "T" (strength / pillar) with lotus leaves
// splaying from its base (identity), per the Trayaam Icon System.
// Inherits color via currentColor. Props: size (px), withWordmark (bool), class.
interface Props { size?: number; withWordmark?: boolean; class?: string; }
const { size = 34, withWordmark = false, class: cls = '' } = Astro.props;
---
<span class={`logo ${cls}`} style={`--logo-size:${size}px`}>
  <svg class="logo__mark" viewBox="0 0 820 937" width={Math.round(size * 0.875)} height={size} fill="currentColor" aria-hidden="true"><use href="#trayaam-mark"/></svg>
  {withWordmark && <span class="logo__word">Trayaam</span>}
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--accent); }
  .logo__mark { height: var(--logo-size); width: auto; flex-shrink: 0; }
  .logo__word { font-family: var(--brand); font-size: 1.6rem; font-weight: 600; letter-spacing: 0.04em; color: var(--fg); }
</style>
