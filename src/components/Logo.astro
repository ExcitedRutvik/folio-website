---
// Trayaam monogram: a slab-serif "T" (strength / pillar) with lotus leaves
// splaying from its base (identity), per the Trayaam Icon System.
// Inherits color via currentColor. Props: size (px), withWordmark (bool), class.
interface Props { size?: number; withWordmark?: boolean; class?: string; }
const { size = 34, withWordmark = false, class: cls = '' } = Astro.props;
---
<span class={`logo ${cls}`} style={`--logo-size:${size}px`}>
  <svg class="logo__mark" viewBox="0 0 200 206" width={size} height={size * 1.03} fill="none" aria-hidden="true">
    <!-- fluted column forming a T -->
    <g fill="currentColor">
      <rect x="63" y="46" width="74" height="7" rx="2.5"/>
      <rect x="69" y="55" width="62" height="9" rx="2.5"/>
      <rect x="88" y="66" width="3.6" height="50" rx="1.6"/>
      <rect x="94" y="66" width="3.6" height="50" rx="1.6"/>
      <rect x="100.2" y="66" width="3.6" height="50" rx="1.6"/>
      <rect x="106.4" y="66" width="3.6" height="50" rx="1.6"/>
      <rect x="112.4" y="66" width="3.6" height="50" rx="1.6"/>
    </g>
    <!-- layered lotus bloom -->
    <g fill="currentColor">
      <g opacity="0.55">
        <path d="M100 168 C 80 162 58 150 50 132 C 72 128 94 146 100 168 Z"/>
        <path d="M100 168 C 120 162 142 150 150 132 C 128 128 106 146 100 168 Z"/>
      </g>
      <g opacity="0.78">
        <path d="M100 168 C 84 158 68 142 66 120 C 86 126 96 148 100 168 Z"/>
        <path d="M100 168 C 116 158 132 142 134 120 C 114 126 104 148 100 168 Z"/>
      </g>
      <g opacity="0.92">
        <path d="M100 168 C 89 152 80 134 82 114 C 95 124 99 148 100 168 Z"/>
        <path d="M100 168 C 111 152 120 134 118 114 C 105 124 101 148 100 168 Z"/>
      </g>
      <path d="M100 168 C 91 146 91 122 100 106 C 109 122 109 146 100 168 Z"/>
    </g>
  </svg>
  {withWordmark && <span class="logo__word">Trayaam</span>}
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--accent); }
  .logo__mark { width: var(--logo-size); height: var(--logo-size); flex-shrink: 0; }
  .logo__word { font-family: var(--brand); font-size: 1.6rem; font-weight: 600; letter-spacing: 0.04em; color: var(--fg); }
</style>
