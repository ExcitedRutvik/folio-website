---
// Trayaam monogram: a slab-serif "T" (strength / pillar) with lotus leaves
// splaying from its base (identity), per the Trayaam Icon System.
// Inherits color via currentColor. Props: size (px), withWordmark (bool), class.
interface Props { size?: number; withWordmark?: boolean; class?: string; }
const { size = 34, withWordmark = false, class: cls = '' } = Astro.props;
---
<span class={`logo ${cls}`} style={`--logo-size:${size}px`}>
  <svg class="logo__mark" viewBox="0 0 48 48" width={size} height={size} fill="none" aria-hidden="true">
    <!-- slab-serif T -->
    <g class="logo__t" fill="currentColor">
      <rect x="9" y="9" width="30" height="4.6" rx="0.8"/>
      <rect x="9" y="9" width="4.2" height="7.6" rx="0.8"/>
      <rect x="34.8" y="9" width="4.2" height="7.6" rx="0.8"/>
      <rect x="21.7" y="11.4" width="4.6" height="21.8" rx="0.9"/>
    </g>
    <!-- lotus leaves fanning from the foot of the T -->
    <g class="logo__lotus" fill="currentColor">
      <path d="M24 33 C 22.7 28.6 22.7 24.6 24 20.6 C 25.3 24.6 25.3 28.6 24 33 Z" opacity="0.45" transform="rotate(-72 24 33)"/>
      <path d="M24 33 C 22.7 28.6 22.7 24.6 24 20.6 C 25.3 24.6 25.3 28.6 24 33 Z" opacity="0.45" transform="rotate(72 24 33)"/>
      <path d="M24 33 C 22.7 28.2 22.7 23.8 24 19.8 C 25.3 23.8 25.3 28.2 24 33 Z" opacity="0.7" transform="rotate(-48 24 33)"/>
      <path d="M24 33 C 22.7 28.2 22.7 23.8 24 19.8 C 25.3 23.8 25.3 28.2 24 33 Z" opacity="0.7" transform="rotate(48 24 33)"/>
      <path d="M24 33 C 22.8 27.8 22.8 23 24 19 C 25.2 23 25.2 27.8 24 33 Z" opacity="0.95" transform="rotate(-24 24 33)"/>
      <path d="M24 33 C 22.8 27.8 22.8 23 24 19 C 25.2 23 25.2 27.8 24 33 Z" opacity="0.95" transform="rotate(24 24 33)"/>
    </g>
  </svg>
  {withWordmark && <span class="logo__word">Trayaam</span>}
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--accent); }
  .logo__mark { width: var(--logo-size); height: var(--logo-size); flex-shrink: 0; }
  .logo__word { font-family: var(--serif); font-size: 1.5rem; font-weight: 500; letter-spacing: -0.03em; color: var(--fg); }
</style>
