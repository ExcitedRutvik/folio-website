---
// Trayaam logomark: official gold T-pillar + lotus emblem (raster, true alpha).
// WebP primary with PNG fallback. Props: size (px height), withWordmark, class.
interface Props { size?: number; withWordmark?: boolean; class?: string; }
const { size = 34, withWordmark = false, class: cls = '' } = Astro.props;
// Source asset is 600×716 (aspect ≈ 0.838); width derived from height.
const w = Math.round(size * 0.838);
---
<span class={`logo ${cls}`} style={`--logo-size:${size}px`}>
  <picture class="logo__mark">
    <source srcset="/logo.webp" type="image/webp" />
    <img src="/logo.png" width={w} height={size} alt="" aria-hidden="true" decoding="async" />
  </picture>
  {withWordmark && <span class="logo__word">Trayaam</span>}
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.5rem; }
  .logo__mark { display: inline-flex; height: var(--logo-size); }
  .logo__mark img { height: var(--logo-size); width: auto; display: block; flex-shrink: 0; }
  .logo__word { font-family: var(--brand); font-size: 1.6rem; font-weight: 600; letter-spacing: 0.04em; color: var(--fg); }
</style>
