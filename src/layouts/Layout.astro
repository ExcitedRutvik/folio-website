---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const {
  title = 'Trayaam · Digital Transformation & Growth Partner',
  description = "Trayaam is a full service digital growth partner in London and Ahmedabad. We help ambitious businesses get found online and win more customers through design, build, SEO and marketing.",
  active = '',
  path = '',
  ogImage = '/assets/og-image.png',
  jsonld = null,
} = Astro.props;

const site = 'https://trayaam.com';
// Canonical must match the URL the host actually serves (trailing slash, 200),
// not the no-slash variant that 308-redirects to it.
const rawPath = path || Astro.url.pathname;
const canonicalPath = rawPath === '/' ? '/' : rawPath.replace(/\/+$/, '') + '/';
const canonical = site + canonicalPath;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script is:inline>
    /* Apply saved theme before paint (no flash). Default dark. */
    (function () {
      try {
        var t = localStorage.getItem('trayaam-theme');
        if (!t) t = 'dark';
        document.documentElement.setAttribute('data-theme', t);
      } catch (e) { document.documentElement.setAttribute('data-theme', 'dark'); }
    })();
  </script>
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-96.png" sizes="96x96" type="image/png" />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#0A0A0B" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Trayaam" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={site + ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="en_GB" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={site + ogImage} />

  <meta name="robots" content="index, follow, max-image-preview:large" />
  <meta name="author" content="Trayaam" />
  <meta name="geo.region" content="GB-LND" />
  <meta name="geo.placename" content="London" />
  <meta name="geo.region" content="IN-GJ" />
  <meta name="geo.placename" content="Ahmedabad" />

  {/* Global Organization + WebSite graph, knowledge-panel & generative-engine signals */}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": site + "/#org",
        "name": "Trayaam",
        "url": site,
        "logo": site + "/favicon.svg",
        "image": site + ogImage,
        "email": "akash@trayaam.com",
        "slogan": "Creativity · Technology · Empowerment",
        "description": "Full service digital growth partner with studios in London and Ahmedabad. We help ambitious businesses get found and win more customers through design, build, SEO, marketing and automation.",
        "areaServed": ["London","Ahmedabad","United Kingdom","India"],
        "address": [
          { "@type": "PostalAddress", "addressLocality": "London", "addressCountry": "GB" },
          { "@type": "PostalAddress", "addressLocality": "Ahmedabad", "addressRegion": "Gujarat", "addressCountry": "IN" }
        ],
        "telephone": "+919978984333",
        "contactPoint": { "@type": "ContactPoint", "email": "akash@trayaam.com", "telephone": "+919978984333", "contactType": "sales", "areaServed": "Worldwide", "availableLanguage": ["en","hi","gu"] }
      },
      { "@type": "WebSite", "@id": site + "/#website", "url": site, "name": "Trayaam", "publisher": { "@id": site + "/#org" } }
    ]
  })} />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;1,9..144,300;1,9..144,400&family=Inter+Tight:wght@300..600&family=JetBrains+Mono:wght@400;500&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;1,9..144,300;1,9..144,400&family=Inter+Tight:wght@300..600&family=JetBrains+Mono:wght@400;500&display=swap" />

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-WSK1XQY3FB"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-WSK1XQY3FB');
  </script>

  <slot name="head" />
</head>
<body>
  <Nav active={active} />
  <main>
    <slot />
  </main>
  <Footer />

  <script is:inline>
    /* Dual-studio clock (London + Ahmedabad) + footer mirror */
    (function () {
      function fmt(tz) { return new Date().toLocaleTimeString('en-GB', { timeZone: tz, hour: '2-digit', minute: '2-digit' }); }
      function tick() {
        var ldn = fmt('Europe/London'), amd = fmt('Asia/Kolkata');
        var el = document.getElementById('clock');
        if (el) el.textContent = 'LDN ' + ldn + ' · AMD ' + amd;
        var f = document.getElementById('footer-clock');
        if (f) f.textContent = 'LDN ' + ldn + ' · AMD ' + amd;
      }
      tick(); setInterval(tick, 30000);
    })();

    /* Scroll reveal */
    (function () {
      var els = document.querySelectorAll('.reveal');
      if (!('IntersectionObserver' in window)) { els.forEach(function (e) { e.classList.add('in'); }); return; }
      var obs = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); obs.unobserve(e.target); } });
      }, { threshold: 0.14, rootMargin: '0px 0px -8% 0px' });
      els.forEach(function (el) { obs.observe(el); });
    })();

    /* Count-up [data-count] */
    (function () {
      var els = document.querySelectorAll('[data-count]');
      if (!els.length) return;
      if (!('IntersectionObserver' in window)) { els.forEach(function (el) { el.textContent = el.dataset.count; }); return; }
      var obs = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          var el = e.target, target = parseFloat(el.dataset.count), start = performance.now(), dur = 1400;
          (function frame(now) {
            var p = Math.min((now - start) / dur, 1), eased = 1 - Math.pow(1 - p, 3), v = target * eased;
            el.textContent = target >= 100 ? Math.round(v) : v.toFixed(1).replace(/\.0$/, '');
            if (p < 1) requestAnimationFrame(frame); else el.textContent = el.dataset.count;
          })(start);
          obs.unobserve(el);
        });
      }, { threshold: 0.4 });
      els.forEach(function (el) { obs.observe(el); });
    })();
  </script>
</body>
</html>
