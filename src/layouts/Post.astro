---
import Layout from './Layout.astro';
import PageHero from '../components/PageHero.astro';
const { title, description, path, date, readtime, category } = Astro.props;
const jsonld = {
  "@context": "https://schema.org", "@type": "Article", "headline": title, "description": description,
  "datePublished": date, "author": { "@type": "Organization", "name": "Trayaam" },
  "publisher": { "@type": "Organization", "name": "Trayaam" }, "mainEntityOfPage": "https://trayaam.com" + path
};
---
<Layout title={`${title} · Trayaam Journal`} description={description} active="blog" path={path} jsonld={jsonld}>
<style>
  .post-layout { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
  .article { max-width: 720px; }
  .article :global(h2) { font-family: var(--serif); font-weight: 400; font-size: clamp(1.5rem,2.6vw,2.1rem); letter-spacing: -0.02em; margin: 3rem 0 1.2rem; scroll-margin-top: 96px; }
  .article :global(h3) { font-family: var(--serif); font-weight: 400; font-size: 1.3rem; margin: 2.2rem 0 1rem; }
  .article :global(p) { color: var(--fg-med); line-height: 1.85; margin-bottom: 1.4rem; font-size: clamp(1rem,0.5vw+0.9rem,1.15rem); }
  .article :global(ul) { margin: 0 0 1.4rem 1.2rem; }
  .article :global(li) { color: var(--fg-med); line-height: 1.8; margin-bottom: 0.6rem; list-style: disc; }
  .article :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .article :global(strong) { color: var(--fg); }
  .article :global(blockquote) { border-left: 2px solid var(--accent-mid); padding-left: 1.4rem; margin: 2rem 0; font-family: var(--serif); font-style: italic; font-size: 1.25rem; color: var(--fg-hi); }
  .post-meta { display: flex; gap: 1rem; font-family: var(--mono); font-size: 0.72rem; color: var(--fg-lo); letter-spacing: 0.04em; }

  /* Sticky floating sidebar */
  .post-aside { position: sticky; top: 96px; display: flex; flex-direction: column; gap: 1.2rem; }
  .toc { border: 1px solid var(--border); border-radius: var(--r-lg); background: var(--bg-1); padding: 1.4rem 1.5rem; }
  .toc__title { font-family: var(--mono); font-size: 0.62rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--fg-lo); margin-bottom: 1rem; }
  .toc__list { display: flex; flex-direction: column; gap: 0.1rem; }
  .toc__list a { font-size: 0.86rem; color: var(--fg-med); padding: 0.4rem 0; line-height: 1.4; border-left: 2px solid transparent; padding-left: 0.8rem; margin-left: -0.8rem; transition: color 0.2s, border-color 0.2s; }
  .toc__list a:hover { color: var(--fg); }
  .toc__list a.active { color: var(--accent); border-left-color: var(--accent); }
  .toc__empty { font-size: 0.82rem; color: var(--fg-faint); }
  .audit-cta { border: 1px solid var(--accent-mid); border-radius: var(--r-lg); background: var(--accent-dim); padding: 1.5rem; }
  .audit-cta h3 { font-family: var(--serif); font-weight: 400; font-size: 1.25rem; line-height: 1.1; margin-bottom: 0.6rem; }
  .audit-cta p { font-size: 0.85rem; color: var(--fg-med); line-height: 1.55; margin-bottom: 1.1rem; }

  @media (max-width: 900px) { .post-layout { grid-template-columns: 1fr; } .post-aside { position: static; } .toc { display: none; } }
</style>
<PageHero eyebrow={category}>
  <h1 slot="title" class="t-h1 reveal">{title}</h1>
  <div class="post-meta reveal reveal-d1" style="margin-top:1.5rem;"><span>{date}</span><span>·</span><span>{readtime}</span></div>
</PageHero>
<section class="section section--major section--line">
  <div class="container post-layout">
    <article class="article reveal" id="article"><slot /></article>
    <aside class="post-aside">
      <nav class="toc reveal" aria-label="On this page">
        <div class="toc__title">What this article contains</div>
        <div class="toc__list" id="toc"><span class="toc__empty">Sections appear here.</span></div>
      </nav>
      <div class="audit-cta reveal reveal-d1">
        <h3>Book a website audit</h3>
        <p>A free 12-metric scan — performance, SEO, mobile, security and design — in 24 hours.</p>
        <a href="/contact" class="btn btn--accent" style="width:100%;justify-content:center;padding:0.7em 1.2em;font-size:0.82rem;">Get your free audit <span class="arr">→</span></a>
      </div>
    </aside>
  </div>
</section>
<section class="section section--major section--line section--surface">
  <div class="container container--narrow" style="text-align:center;">
    <h2 class="t-h2 reveal">Want this for <em class="italic">your site?</em></h2>
    <div style="margin-top:2rem;" class="reveal"><a href="/contact" class="btn btn--accent">Get a free audit <span class="arr">→</span></a></div>
  </div>
</section>
<script is:inline>
  /* Build "What this article contains" from the article's H2s, then scroll-spy. */
  (function () {
    var article = document.getElementById('article'), toc = document.getElementById('toc');
    if (!article || !toc) return;
    var heads = Array.prototype.slice.call(article.querySelectorAll('h2'));
    if (!heads.length) { toc.innerHTML = ''; return; }
    toc.innerHTML = '';
    var links = [];
    heads.forEach(function (h, i) {
      if (!h.id) h.id = 'section-' + (i + 1) + '-' + h.textContent.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
      var a = document.createElement('a');
      a.href = '#' + h.id; a.textContent = h.textContent;
      toc.appendChild(a); links.push(a);
    });
    if (!('IntersectionObserver' in window)) return;
    var byId = {};
    links.forEach(function (a) { byId[a.getAttribute('href').slice(1)] = a; });
    var obs = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) {
          links.forEach(function (l) { l.classList.remove('active'); });
          var a = byId[e.target.id]; if (a) a.classList.add('active');
        }
      });
    }, { rootMargin: '-20% 0px -70% 0px' });
    heads.forEach(function (h) { obs.observe(h); });
  })();
</script>
</Layout>
